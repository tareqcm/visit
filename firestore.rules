rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check endpoint for connection verification
    match /test/connection {
      allow read: if true;
    }

    // Strict multi-tenant data isolation per Officer (users/{userId}/...)
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Officer Profile & Settings
      match /profile/{docId} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }

      // Officer's Samities
      match /samities/{samityId} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }

      // Officer's Monthly Schedules
      match /months/{monthKey} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }

      // Officer's Field Photos
      match /photos/{photoId} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }

      // Officer's Saved Monthly Reports
      match /reports/{reportId} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
