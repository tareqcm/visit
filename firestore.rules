rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health check endpoint for connection verification
    match /test/connection {
      allow read: if true;
    }

    // Officers Registry (Index of all Field Assistants for Admin Panel)
    match /officers_registry/{officerId} {
      allow read, write: if true;
    }

    // Admin role definitions
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Multi-tenant data partition per Officer (users/{userId}/...)
    // Partitioned per officer UID / officer ID so each officer uses their own isolated vault
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /{allSubcollections=**} {
        allow read, write: if isValidId(userId);
      }
    }
  }
}
